<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HideIt</RootNamespace>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Our.Umbraco.HideIt</PackageId>
    <Product>HideIt</Product>
    <Title>Hide It - Block Visibility Toggle</Title>
    <Description>Toggle block visibility directly from the block action bar. Blocks with hideIt=true are automatically filtered from frontend rendering.</Description>
    <Authors>Andreas Lykke Borg</Authors>
    <PackageTags>umbraco;umbraco-marketplace;block;visibility;hide;toggle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/andreaslborg/HideIt</PackageProjectUrl>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[18.1.1, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.1.1, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="HideIt.Test\**\*.cs" />
    <Content Remove="HideIt.Test\**" />
    <EmbeddedResource Remove="HideIt.Test\**" />
    <None Remove="HideIt.Test\**" />

    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <ClientBuildInput Include="Client/package.json;Client/package-lock.json;Client/tsconfig.json;Client/vite.config.ts;Client/src/**;Client/public/**" />
  </ItemGroup>

  <Target Name="BuildClient" Inputs="@(ClientBuildInput)" Outputs="$(IntermediateOutputPath)hideit.client.stamp" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
    <Touch Files="$(IntermediateOutputPath)hideit.client.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeClientAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildClient">
    <!-- Vite output does not exist when MSBuild first evaluates a clean checkout. -->
    <ItemGroup>
      <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
