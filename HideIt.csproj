<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HideIt</RootNamespace>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Our.Umbraco.HideIt</PackageId>
    <Product>HideIt</Product>
    <Title>Hide It - Block Visibility Toggle</Title>
    <Description>Toggle block visibility directly from the block action bar. Blocks with hideIt=true are automatically filtered from frontend rendering.</Description>
    <Authors>Andreas Lykke Borg</Authors>
    <PackageTags>umbraco;umbraco-marketplace;block;visibility;hide;toggle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/andreaslborg/HideIt</PackageProjectUrl>
    <Version>18.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[18.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.0.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**"/>

    <!-- However make the umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false"/>
  </ItemGroup>

  <!-- Include wwwroot files as static web assets -->
  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
